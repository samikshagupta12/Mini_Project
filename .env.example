# Database Mode: demo (in-memory mock) by default. Zero MongoDB installation required!
# Change USE_MOCK_DB=false and DEMO_MODE=false to connect to Real local/Atlas MongoDB
USE_MOCK_DB=true
DEMO_MODE=true

# MongoDB Connection String (used when USE_MOCK_DB=false or testing real connection)
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_interview_system
APP_ENV=development

# Administrator Role Credentials
ADMIN_EMAIL=admin@interviewprep.com
ADMIN_PASSWORD=admin123
